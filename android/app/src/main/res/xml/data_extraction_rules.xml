<?xml version="1.0" encoding="utf-8"?>
<!-- Health, notification and diagnostic data never leave the device through backups. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="file" path="captures" />
        <exclude domain="file" path="faces" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
